# Security Settings
SECRET_KEY=change-this-in-production-to-a-secure-random-string
DEBUG=True
ALLOWED_HOSTS=*

# Database Configuration
# Supported engines: django.db.backends.sqlite3 (Default local zero-setup) or django.db.backends.postgresql
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Language Model Configuration
# Options: 'ollama', 'openai', 'mock'
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# OpenAI Configuration (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Speech Configuration
STT_ENGINE=whisper
WHISPER_MODEL=base
TTS_LANGUAGE=en

# RAG Configuration
SIMILARITY_THRESHOLD=0.3
MAX_RETRIEVED_CONTEXTS=4
EMBEDDING_DIM=384
